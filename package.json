{
  "name": "lumin-time",
  "version": "0.1.18",
  "private": true,
  "description": "A privacy-first browser extension that automatically tracks your online activity.",
  "homepage": "https://github.com/nuttycc/LuminTime",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "mkdir -p node_modules/.cache/vue-tsc && vue-tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "vp lint --type-aware .",
    "format": "vp fmt",
    "test": "vp test run",
    "postinstall": "wxt prepare",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tanstack/pacer": "^0.19.0",
    "@vueuse/core": "^14.2.1",
    "arktype": "^2.2.0",
    "dexie": "^4.4.2",
    "es-toolkit": "^1.45.1",
    "motion-v": "^2.2.0",
    "pretty-ms": "^9.3.0",
    "tldts": "^7.0.27",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.15",
    "vue-tsc": "^3.2.6",
    "wxt": "^0.20.20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "spawn-sync"
    ]
  }
}
